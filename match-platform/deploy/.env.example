# PropMatch 环境变量示例
# 复制到 /srv/propmatch/.env，修改后 chmod 600
# 生产检查：COOKIE_SECURE=1、SESSION_SECRET 随机、SHOW_DEMO=0

PORT=4100
HOST=127.0.0.1
DATA_DIR=/srv/propmatch/data

# 32+ 字节随机值，例如：openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-hex-string

# 生产 HTTPS 必须为 1
COOKIE_SECURE=1

# 空库时是否写演示数据；正式上线建议 0（或仅首次演示时 1）
SEED_DEMO=0

# 是否展示演示账号与 ?demo=1 自动登录；生产必须 0
SHOW_DEMO=0

# 是否允许非演示账号调用 /api/demo/reset；生产保持 0
ALLOW_DEMO_RESET=0
